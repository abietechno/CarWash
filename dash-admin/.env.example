VITE_APP_NAME="CarWash Cloud Admin"

# Base URL API yang dipanggil browser. Default '/api' (lewat proxy Vite saat dev).
VITE_API_URL=/api

# Alamat backend untuk proxy Vite saat `npm run dev`.
VITE_API_PROXY=http://127.0.0.1:8000

# Landing page (link "Daftar gratis" di halaman login).
VITE_LANDING_URL=http://carwash.localhost:8000
