# =============================================================================
# PRODUCTION — Backend Laravel: landing page + API
# Melayani:  https://carwash.cloudbizz.my.id        (landing + /api)
#            https://dash-admin.cloudbizz.my.id/api (diteruskan nginx ke sini)
#            https://xxxx.cloudbizz.my.id/api       (diteruskan nginx, Host asli dipertahankan)
#
# Pakai di server:
#   cp .env.production.example .env
#   isi DB_PASSWORD, lalu: php artisan key:generate && php artisan migrate --force
#   php artisan config:cache && php artisan route:cache
# File .env asli berisi rahasia — jangan di-commit.
# =============================================================================

APP_NAME="WashWuzz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://carwash.cloudbizz.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# --- SaaS multi-tenant ---------------------------------------------------------
# Tenant dikenali dari subdomain: {subdomain}.cloudbizz.my.id
SAAS_BASE_DOMAIN=cloudbizz.my.id
SAAS_TENANT_URL="https://{subdomain}.cloudbizz.my.id"
SAAS_ADMIN_URL="https://dash-admin.cloudbizz.my.id"
SAAS_LANDING_URL="https://carwash.cloudbizz.my.id"
SAAS_TIMEZONE=Asia/Jakarta
# Subdomain tenant contoh untuk tombol "Lihat Contoh Situs" di landing. Kosong = tombol disembunyikan.
SAAS_DEMO_SUBDOMAIN=

# Semua frontend memanggil /api di domainnya sendiri (same-origin), jadi CORS hanya untuk jaga-jaga.
CORS_ALLOWED_ORIGINS=https://carwash.cloudbizz.my.id,https://dash-admin.cloudbizz.my.id

# --- Database (MariaDB di aaPanel) -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carwash_cloud
DB_USERNAME=carwash_cloud
DB_PASSWORD=

# --- Session / cache / queue -------------------------------------------------------
# Dashboard memakai token API (Sanctum), session hanya untuk halaman web.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Log ---------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Email (belum dipakai) -------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@cloudbizz.my.id"
MAIL_FROM_NAME="${APP_NAME}"
