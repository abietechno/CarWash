# Situs publik tenant ({subdomain}.cloudbizz.my.id).
# Nilai bawaan sudah ada di .env.development (lokal) dan .env.production (server);
# salin ke .env.local hanya kalau perlu menimpa di komputer sendiri.

# Landing page CarWash Cloud.
VITE_LANDING_URL=http://carwash.localhost:8000

# Hanya untuk `npm run dev`: alamat backend Laravel yang diproxy di /api.
VITE_API_PROXY=http://127.0.0.1:8000
